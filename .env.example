# ============================================================
# JoyFlix 环境变量示例
# 复制为 .env.local 后按需修改：
#   cp .env.example .env.local
# 以 NEXT_PUBLIC_ 开头的变量会被打包进浏览器端代码，
# 不要往里放任何机密信息。
#
# 【重要 · 已实测】NEXT_PUBLIC_* 是「构建期」注入，不是运行时读取。
# 实测方法：用 NEXT_PUBLIC_BASE_URL=<唯一值> 构建，该值随即出现在
#   .next/server/app/api/recommendations/route.js
# 中，即已被编译成字面量写进服务端 bundle。
# 后果：Docker 部署时 `docker run -e NEXT_PUBLIC_XXX=...` 不生效，
#   镜像里永远是构建时的值。要改站点级配置，请改用：
#     1) 挂载 config.json（推荐，README 有示例）或走管理后台；或
#     2) 在 Dockerfile 的 builder 阶段加 ARG/ENV 后重新构建镜像。
# 非 NEXT_PUBLIC_ 的变量（USERNAME / PASSWORD / REDIS_URL / UPSTASH_* 等）
# 不受此限，容器启动时用 -e 传入即可。
# ============================================================

# ---------- 站点基础 ----------
# 站点名称，同时用于生成 PWA 的 manifest.json
NEXT_PUBLIC_SITE_NAME=JoyFlix

# 站点公告，展示在首页
ANNOUNCEMENT=

# ---------- 管理员认证 ----------
# 不设置 PASSWORD 时，所有页面会被重定向到 /warning
USERNAME=admin
PASSWORD=

# ---------- 存储后端 ----------
# 可选：localstorage | redis | d1 | upstash
# localstorage 仅浏览器本地存储，换设备不同步，无需 Redis
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# redis 模式必填，例如 redis://127.0.0.1:6379
REDIS_URL=

# upstash 模式必填（在 Upstash 控制台获取）
UPSTASH_URL=
UPSTASH_TOKEN=

# ---------- 站点地址 ----------
# 必须填站点对外可访问的完整地址（如 https://flix.example.com）
# /api/recommendations 会回调本站接口，不填会导致搜索推荐功能失效
NEXT_PUBLIC_BASE_URL=

# ---------- 搜索 ----------
# 搜索接口最多拉取多少页，取值 1-50
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# ---------- 豆瓣数据源 ----------
# 数据请求方式：direct | cors-proxy-zwei | cmliussss-cdn-tencent | cmliussss-cdn-ali | custom
# direct 表示由服务器直接请求豆瓣源站
NEXT_PUBLIC_DOUBAN_PROXY_TYPE=direct
# 仅当上面选 custom 时生效
NEXT_PUBLIC_DOUBAN_PROXY=

# 图片代理方式：direct | server | img3 | cmliussss-cdn-tencent | cmliussss-cdn-ali | custom
# 默认 server（经服务端 /api/image-proxy 转发，由服务端带上 Referer 以规避豆瓣 CDN 返回 418）。
# 注意：img3 仅改写域名、仍由浏览器直连豆瓣 CDN，会因无 Referer 返回 418；
#       direct 同样会被豆瓣 CDN 拒绝（浏览器直连返回 418）。若出现海报/封面加载异常，
#       请勿改用 direct 或 img3，应使用 server。
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=server
# 仅当上面选 custom 时生效
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=

# ---------- 部署相关（通常无需手动设置）----------
# Docker 构建时由 Dockerfile 自动设为 true，
# 作用是让 config.ts 从 config.json 读取配置而非使用编译期快照
DOCKER_ENV=

# libuv 线程池大小，镜像内已由 Dockerfile 设默认值 16，一般无需改动。
# 背景：DNS 解析（getaddrinfo）跑在 libuv 线程池上，Node 默认只有 4 个线程。
# 本站在搜索/定时任务中会同时访问 27 个采集源，27 路域名解析挤在 4 个线程里排队，
# 排队时间会超过单源 8 秒超时阈值，表现为「所有源同时失灵」：搜索返回空结果、
# 收藏刷新成批失败，而日志里既没有网络错误也没有鉴权错误——极难排查。
# 实测同一台服务器：默认 4 线程时 24 个片名只有 2 个能搜到；改为 16 后提升到 17 个。
UV_THREADPOOL_SIZE=16

# ---------- 定时任务（/api/cron）----------
# 触发 `/api/cron` 全量刷新（遍历所有用户的播放记录与收藏、并发访问采集源，实测 2~4 分钟）
# 所需的共享令牌。**留空则不校验**（保持历史行为），任何能访问站点的人都能触发该重活，
# 生产环境建议设置一个随机串。
#   - 容器内：start.js 会自动把它放进 `x-cron-token` 请求头
#   - 手动触发：docker exec joyflix-core wget -qO- \
#       --header="x-cron-token: $CRON_TOKEN" http://127.0.0.1:3000/api/cron
#     必须写 127.0.0.1：容器内 localhost 解析为 IPv6 ::1，而服务只监听 IPv4，会连接被拒。
#     不要从公网域名触发：站点经 Cloudflare Tunnel 暴露，Cloudflare 代理等待上限约 100 秒，
#     而一次完整刷新 2~4 分钟，公网调用会拿到 HTTP 524（服务端其实仍在跑完）。
# 注意：/api/cron 在 middleware 的鉴权豁免名单内，不带登录 Cookie 也能访问，
# 因此这个令牌是它唯一的保护。生成方式：openssl rand -base64 32
CRON_TOKEN=

# 注意：源码中另有 STORAGE_TYPE（无 NEXT_PUBLIC_ 前缀）在 src/lib/db.client.ts 被读取，
# 但它位于 'use client' 文件里，Next.js 不会内联非 NEXT_PUBLIC_ 变量，
# 因此该分支实际取不到值（运行时靠 layout 注入的 RUNTIME_CONFIG 兜底）。不要在此设置它。
