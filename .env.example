# ============================================================
# JoyFlix 环境变量示例
# 复制为 .env.local 后按需修改：
#   cp .env.example .env.local
# 以 NEXT_PUBLIC_ 开头的变量会被打包进浏览器端代码，
# 不要往里放任何机密信息。
#
# 【重要 · 已实测】NEXT_PUBLIC_* 是「构建期」注入，不是运行时读取。
# 实测方法：用 NEXT_PUBLIC_BASE_URL=<唯一值> 构建，该值随即出现在
#   .next/server/app/api/recommendations/route.js
# 中，即已被编译成字面量写进服务端 bundle。
# 后果：Docker 部署时 `docker run -e NEXT_PUBLIC_XXX=...` 不生效，
#   镜像里永远是构建时的值。要改站点级配置，请改用：
#     1) 挂载 config.json（推荐，README 有示例）或走管理后台；或
#     2) 在 Dockerfile 的 builder 阶段加 ARG/ENV 后重新构建镜像。
# 非 NEXT_PUBLIC_ 的变量（USERNAME / PASSWORD / REDIS_URL / UPSTASH_* 等）
# 不受此限，容器启动时用 -e 传入即可。
# ============================================================

# ---------- 站点基础 ----------
# 站点名称，同时用于生成 PWA 的 manifest.json
NEXT_PUBLIC_SITE_NAME=JoyFlix

# 站点公告，展示在首页
ANNOUNCEMENT=

# ---------- 管理员认证 ----------
# 不设置 PASSWORD 时，所有页面会被重定向到 /warning
USERNAME=admin
PASSWORD=

# ---------- 存储后端 ----------
# 可选：localstorage | redis | d1 | upstash
# localstorage 仅浏览器本地存储，换设备不同步，无需 Redis
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# redis 模式必填，例如 redis://127.0.0.1:6379
REDIS_URL=

# upstash 模式必填（在 Upstash 控制台获取）
UPSTASH_URL=
UPSTASH_TOKEN=

# ---------- 站点地址 ----------
# 必须填站点对外可访问的完整地址（如 https://flix.example.com）
# /api/recommendations 会回调本站接口，不填会导致搜索推荐功能失效
NEXT_PUBLIC_BASE_URL=

# ---------- 搜索 ----------
# 搜索接口最多拉取多少页，取值 1-50
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# ---------- 豆瓣数据源 ----------
# 数据请求方式：direct | cors-proxy-zwei | cmliussss-cdn-tencent | cmliussss-cdn-ali | custom
# direct 表示由服务器直接请求豆瓣源站
NEXT_PUBLIC_DOUBAN_PROXY_TYPE=direct
# 仅当上面选 custom 时生效
NEXT_PUBLIC_DOUBAN_PROXY=

# 图片代理方式：direct | server | img3 | cmliussss-cdn-tencent | cmliussss-cdn-ali | custom
# 默认 img3（豆瓣精品 CDN）。若出现海报加载异常，可改为 direct 或 server
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=img3
# 仅当上面选 custom 时生效
NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=

# ---------- 部署相关（通常无需手动设置）----------
# Docker 构建时由 Dockerfile 自动设为 true，
# 作用是让 config.ts 从 config.json 读取配置而非使用编译期快照
DOCKER_ENV=

# 注意：源码中另有 STORAGE_TYPE（无 NEXT_PUBLIC_ 前缀）在 src/lib/db.client.ts 被读取，
# 但它位于 'use client' 文件里，Next.js 不会内联非 NEXT_PUBLIC_ 变量，
# 因此该分支实际取不到值（运行时靠 layout 注入的 RUNTIME_CONFIG 兜底）。不要在此设置它。
