# npm 镜像源配置
#
# 为什么需要这个文件：
#   服务器位于国内，直连 registry.npmjs.org 极不稳定。实测一次 Docker 构建中
#   pnpm install 在最后一个包上停滞 17 分钟无任何进展（TCP 连接 ESTABLISHED 但无数据），
#   导致镜像构建假死。本地因 ~/.npmrc 已配 npmmirror 而不受影响 —— 容器内没有该文件，
#   所以必须在仓库内声明，才能保证「本地改代码 → 服务器构建」这条链路稳定。
#
# npmmirror 是阿里巴巴运营的 npm 全量镜像。pnpm 会用 lockfile 中的 integrity
# 校验每个 tarball，镜像即使被篡改也会因校验失败而中止，因此安全性有保障。
#
# 如需改用其它源，直接修改本文件或在外层用 `pnpm config set registry <url>` 覆盖。
registry=https://registry.npmmirror.com/

# 镜像源偶发抖动时多给几次机会，避免构建直接失败
fetch-retries=5
fetch-retry-maxtimeout=120000
